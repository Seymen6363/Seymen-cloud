{{ 'moe-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'moe-shop.js' | asset_url }}" defer></script>

<section class="moe moe-hero" style="min-height: {{ section.settings.height }}vh;">
  <div class="moe-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1920x' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2400' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="moe-hero__shade" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }};"></div>

  <div class="moe-wrap moe-hero__inner">
    {%- if section.settings.eyebrow != blank -%}<span class="moe-eyebrow moe-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="moe-h moe-reveal">{{ section.settings.heading }}</h1>
    <div class="moe-lead moe-reveal">{{ section.settings.text }}</div>
    <div class="moe-hero__ctas moe-reveal">
      {%- if section.settings.btn1_label != blank -%}
        <a class="moe-btn" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }} →</a>
      {%- endif -%}
      {%- if section.settings.btn2_label != blank -%}
        <a class="moe-btn moe-btn--ghost" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="moe-hero__badges moe-reveal">
        {%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Moè Hero (Video)",
  "tag": "div",
  "class": "moe-section",
  "settings": [
    { "type": "video", "id": "video", "label": "Hintergrund-Video (z. B. Seedance-Clip)", "info": "MP4, 5–10 Sek., ohne Ton, Querformat 16:9" },
    { "type": "image_picker", "id": "image", "label": "Fallback-Bild (GPT Image)", "info": "Wird gezeigt, wenn kein Video gesetzt ist. 2400 × 1350 px" },
    { "type": "range", "id": "overlay", "label": "Abdunkelung", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 85 },
    { "type": "range", "id": "height", "label": "Höhe", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 90 },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überzeile", "default": "Handgemacht · Vegan · Plastikfrei" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Pure Natur für deine Haut." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Naturseifen mit Tonerde & ätherischen Ölen und der kühlende Mentholstein – sanft gereinigt, tief entspannt.</p>" },
    { "type": "text", "id": "btn1_label", "label": "Button 1", "default": "Jetzt entdecken" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 Link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2", "default": "Mentholstein ansehen" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 Link" }
  ],
  "blocks": [
    { "type": "badge", "name": "Vorteil", "limit": 5, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Kostenloser Versand ab 30 €" } ] }
  ],
  "presets": [
    {
      "name": "Moè Hero (Video)",
      "blocks": [
        { "type": "badge", "settings": { "text": "Kostenloser Versand ab 30 €" } },
        { "type": "badge", "settings": { "text": "Kaltgerührt in kleinen Chargen" } },
        { "type": "badge", "settings": { "text": "4,8 ★ aus 1.200+ Bewertungen" } }
      ]
    }
  ]
}
{% endschema %}
