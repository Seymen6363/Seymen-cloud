{{ 'moe-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'moe-shop.js' | asset_url }}" defer></script>

<section class="moe moe-feature{% if section.settings.flip %} moe-feature--flip{% endif %}" id="{{ section.settings.anchor | default: section.id }}" style="--moe-bg: {{ section.settings.bg }};">
  <div class="moe-wrap moe-feature__grid">
    <div class="moe-feature__media moe-reveal">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1200x' }}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1400' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="moe-eyebrow moe-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="moe-h2 moe-reveal">{{ section.settings.heading }}</h2>
      <div class="moe-lead moe-reveal">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="moe-feature__list moe-reveal">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- assign p = section.settings.product -%}
      {%- if p != blank -%}
        <a class="moe-btn moe-reveal" href="{{ p.url }}">{{ section.settings.btn_label | default: 'Jetzt kaufen' }} · {{ p.price | money }}</a>
      {%- elsif section.settings.btn_label != blank -%}
        <a class="moe-btn moe-reveal" href="{{ section.settings.btn_link | default: '#' }}">{{ section.settings.btn_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Moè Video + Text",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (Seedance-Clip)", "info": "Hochformat 4:5 oder 9:16 wirkt am besten" },
    { "type": "image_picker", "id": "image", "label": "Fallback-Bild (GPT Image)" },
    { "type": "checkbox", "id": "flip", "label": "Video rechts anzeigen", "default": false },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#e8f2ee" },
    { "type": "text", "id": "anchor", "label": "Anker-ID (für Links wie #mentholstein)", "default": "mentholstein" },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Der Klassiker neu entdeckt" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Mentholstein – Frische, die man spürt." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Reine Mentholkristalle in handlicher Form. Einfach über Nacken, Schläfen oder Stirn streichen – die angenehme Kühle wirkt sofort.</p>" },
    { "type": "product", "id": "product", "label": "Verknüpftes Produkt" },
    { "type": "text", "id": "btn_label", "label": "Button-Text", "default": "Jetzt kaufen" },
    { "type": "url", "id": "btn_link", "label": "Button-Link (falls kein Produkt)" }
  ],
  "blocks": [
    { "type": "point", "name": "Punkt", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Sofort kühlender Effekt" } ] }
  ],
  "presets": [
    {
      "name": "Moè Video + Text",
      "blocks": [
        { "type": "point", "settings": { "text": "Sofort kühlend bei Verspannungen & Kopfdruck" } },
        { "type": "point", "settings": { "text": "Reine Mentholkristalle, ohne Zusätze" } },
        { "type": "point", "settings": { "text": "Handlich für Tasche, Büro & Reise" } },
        { "type": "point", "settings": { "text": "Ergiebig – hält monatelang" } }
      ]
    }
  ]
}
{% endschema %}
