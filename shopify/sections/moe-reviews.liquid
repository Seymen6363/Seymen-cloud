{{ 'moe-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'moe-shop.js' | asset_url }}" defer></script>

<section class="moe moe-reviews">
  <div class="moe-wrap">
    <span class="moe-eyebrow moe-reveal" style="color:#fff;background:rgba(255,255,255,.12)">{{ section.settings.eyebrow }}</span>
    <h2 class="moe-h2 moe-reveal">{{ section.settings.heading }}</h2>
    <div class="moe-reviews__track">
      {%- for block in section.blocks -%}
        <figure class="moe-review" {{ block.shopify_attributes }}>
          <div class="moe-review__stars" aria-label="{{ block.settings.stars }} von 5 Sternen">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>
          <p>„{{ block.settings.quote }}“</p>
          <figcaption class="moe-review__who">{{ block.settings.name }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Moè Bewertungen",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Kundenstimmen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Das sagen unsere Kund:innen" }
  ],
  "blocks": [
    {
      "type": "review", "name": "Bewertung",
      "settings": [
        { "type": "range", "id": "stars", "label": "Sterne", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Text", "default": "Meine Haut war noch nie so ausgeglichen." },
        { "type": "text", "id": "name", "label": "Name", "default": "Kund:in, verifizierter Kauf" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Moè Bewertungen",
      "blocks": [
        { "type": "review", "settings": { "quote": "Ersetze diesen Text durch eine echte Kundenbewertung.", "name": "Name, verifizierter Kauf" } },
        { "type": "review", "settings": { "quote": "Ersetze diesen Text durch eine echte Kundenbewertung.", "name": "Name, verifizierter Kauf" } },
        { "type": "review", "settings": { "quote": "Ersetze diesen Text durch eine echte Kundenbewertung.", "name": "Name, verifizierter Kauf" } }
      ]
    }
  ]
}
{% endschema %}
