{{ 'moe-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'moe-shop.js' | asset_url }}" defer></script>

{%- assign collection = section.settings.collection -%}
<section class="moe moe-products" id="shop">
  <div class="moe-wrap">
    <div class="moe-products__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="moe-eyebrow moe-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="moe-h2 moe-reveal">{{ section.settings.heading }}</h2>
      </div>
      {%- if collection != blank -%}
        <a class="moe-btn moe-btn--ghost moe-reveal" href="{{ collection.url }}">Alle Produkte</a>
      {%- endif -%}
    </div>

    <div class="moe-products__grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <a class="moe-pcard moe-reveal" href="{{ product.url }}" style="transition-delay: {{ forloop.index0 | times: 70 }}ms">
            <div class="moe-pcard__img">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', widths: '400, 600, 800', alt: product.title }}
                {%- if product.media[1] -%}
                  {{ product.media[1] | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', widths: '400, 600, 800', alt: '' }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="moe-pcard__tag">Sale</span>
              {%- elsif product.tags contains 'Neu' -%}
                <span class="moe-pcard__tag">Neu</span>
              {%- endif -%}
            </div>
            <div class="moe-pcard__body">
              <h3 class="moe-pcard__title">{{ product.title }}</h3>
              {%- if section.settings.show_desc -%}
                <span style="opacity:.7;font-size:14px;line-height:1.5">{{ product.description | strip_html | truncatewords: 14 }}</span>
              {%- endif -%}
              <div class="moe-pcard__price">
                <strong>{{ product.price | money }}</strong>
                {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="moe-pcard">
            <div class="moe-pcard__img">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <div class="moe-pcard__body">
              <h3 class="moe-pcard__title">Produkt {{ i }}</h3>
              <span style="opacity:.7;font-size:14px">Wähle im Editor eine Kollektion aus.</span>
              <div class="moe-pcard__price"><strong>9,90 €</strong></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Moè Produkte",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Bestseller" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Unsere Naturseifen & der Mentholstein" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_desc", "label": "Kurzbeschreibung zeigen", "default": true }
  ],
  "presets": [ { "name": "Moè Produkte" } ]
}
{% endschema %}
