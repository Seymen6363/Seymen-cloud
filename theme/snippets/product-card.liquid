{%- comment -%}
  Produktkarte. Aufruf: {% render 'product-card', product: product, index: forloop.index0, show_desc: true %}
{%- endcomment -%}
<a class="moe-pcard moe-reveal" href="{{ product.url }}" style="transition-delay: {{ index | default: 0 | times: 70 }}ms">
  <div class="moe-pcard__img">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', widths: '400, 600, 800', alt: product.featured_media.alt | default: product.title }}
      {%- if product.media[1] -%}
        {{ product.media[1] | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', widths: '400, 600, 800', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'moe-placeholder' }}
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="moe-pcard__tag">Ausverkauft</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="moe-pcard__tag">Sale</span>
    {%- elsif product.tags contains 'Neu' -%}
      <span class="moe-pcard__tag">Neu</span>
    {%- endif -%}
  </div>
  <div class="moe-pcard__body">
    <h3 class="moe-pcard__title">{{ product.title }}</h3>
    {%- if show_desc -%}
      <span class="moe-pcard__desc">{{ product.description | strip_html | truncatewords: 14 }}</span>
    {%- endif -%}
    <div class="moe-pcard__price">
      <strong>{% if product.price_varies %}ab {% endif %}{{ product.price | money }}</strong>
      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
    </div>
  </div>
</a>
