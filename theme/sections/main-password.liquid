<section class="moe moe-page moe-password">
  <div class="moe-wrap moe-center moe-narrow">
    <span class="moe-eyebrow">Bald verfügbar</span>
    <h1 class="moe-h">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="moe-lead">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'moe-search' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="moe-visually-hidden" for="NewsletterEmail">E-Mail</label>
      <input class="moe-input" id="NewsletterEmail" type="email" name="contact[email]" placeholder="Deine E-Mail" required>
      <button class="moe-btn" type="submit">Benachrichtigen</button>
      {%- if form.posted_successfully? -%}<p>Danke! Wir melden uns.</p>{%- endif -%}
    {%- endform -%}

    <details class="moe-password__login">
      <summary>Mit Passwort öffnen</summary>
      {%- form 'storefront_password', class: 'moe-search' -%}
        {{ form.errors | default_errors }}
        <label class="moe-visually-hidden" for="Password">Passwort</label>
        <input class="moe-input" id="Password" type="password" name="password" placeholder="Passwort">
        <button class="moe-btn" type="submit">Öffnen</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Passwortseite", "settings": [] }
{% endschema %}
