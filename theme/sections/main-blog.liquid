{%- paginate blog.articles by 9 -%}
<section class="moe moe-products moe-page-top">
  <div class="moe-wrap">
    <h1 class="moe-h2 moe-center">{{ blog.title }}</h1>
    <div class="moe-products__grid">
      {%- for article in blog.articles -%}
        <a class="moe-pcard moe-reveal" href="{{ article.url }}">
          <div class="moe-pcard__img">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 100vw', widths: '400, 800', alt: article.title }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'moe-placeholder' }}
            {%- endif -%}
          </div>
          <div class="moe-pcard__body">
            <span class="moe-pcard__desc">{{ article.published_at | date: '%d.%m.%Y' }}</span>
            <h2 class="moe-pcard__title">{{ article.title }}</h2>
            <span class="moe-pcard__desc">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
