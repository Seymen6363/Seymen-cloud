
<section class="moe moe-faq">
  <div class="moe-wrap">
    <div class="moe-center">
      <span class="moe-eyebrow moe-reveal">{{ section.settings.eyebrow }}</span>
      <h2 class="moe-h2 moe-reveal">{{ section.settings.heading }}</h2>
    </div>
    <div class="moe-faq__list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.q }}</summary>
          <div>{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Moè FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" }
  ],
  "blocks": [
    { "type": "faq", "name": "Frage", "settings": [
      { "type": "text", "id": "q", "label": "Frage", "default": "Frage" },
      { "type": "richtext", "id": "a", "label": "Antwort", "default": "<p>Antwort</p>" }
    ] }
  ],
  "presets": [
    {
      "name": "Moè FAQ",
      "blocks": [
        { "type": "faq", "settings": { "q": "Für welchen Hauttyp ist die Tonerde-Seife geeignet?", "a": "<p>Besonders für Mischhaut und fettige Haut. Die Tonerde reinigt klärend, die pflanzlichen Öle sorgen dafür, dass die Haut nicht austrocknet.</p>" } },
        { "type": "faq", "settings": { "q": "Wie wende ich den Mentholstein an?", "a": "<p>Den Stein leicht anfeuchten oder direkt über Nacken, Schläfen oder Stirn streichen. Nicht in der Nähe der Augen und nicht auf verletzter Haut anwenden.</p>" } },
        { "type": "faq", "settings": { "q": "Wie lange hält ein Stück Seife?", "a": "<p>Auf einer gut abtropfenden Seifenschale bei täglicher Nutzung etwa 4–6 Wochen.</p>" } },
        { "type": "faq", "settings": { "q": "Wie schnell wird versendet?", "a": "<p>Bestellungen bis 14 Uhr verlassen unser Lager am selben Werktag. Lieferzeit in Deutschland: 1–3 Werktage.</p>" } }
      ]
    }
  ]
}
{% endschema %}
