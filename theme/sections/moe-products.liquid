{%- assign coll = section.settings.collection -%}
<section class="moe moe-products" id="shop">
  <div class="moe-wrap">
    <div class="moe-products__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="moe-eyebrow moe-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="moe-h2 moe-reveal">{{ section.settings.heading }}</h2>
      </div>
      <a class="moe-btn moe-btn--ghost moe-reveal" href="{% if coll != blank %}{{ coll.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Alle Produkte</a>
    </div>

    <div class="moe-products__grid">
      {%- if coll != blank and coll.products_count > 0 -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index0, show_desc: section.settings.show_desc %}
        {%- endfor -%}
      {%- elsif collections.all.products_count > 0 -%}
        {%- for product in collections.all.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index0, show_desc: section.settings.show_desc %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="moe-pcard">
            <div class="moe-pcard__img">{{ 'product-' | append: i | placeholder_svg_tag: 'moe-placeholder' }}</div>
            <div class="moe-pcard__body">
              <h3 class="moe-pcard__title">Produkt {{ i }}</h3>
              <span class="moe-pcard__desc">Lege Produkte an oder wähle im Editor eine Kollektion.</span>
              <div class="moe-pcard__price"><strong>9,90 €</strong></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Moè Produkte",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Bestseller" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Unsere Naturseifen & der Mentholstein" },
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Leer = alle Produkte" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_desc", "label": "Kurzbeschreibung zeigen", "default": true }
  ],
  "presets": [ { "name": "Moè Produkte" } ]
}
{% endschema %}
