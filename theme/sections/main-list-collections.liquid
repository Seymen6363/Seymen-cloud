<section class="moe moe-products moe-page-top">
  <div class="moe-wrap">
    <h1 class="moe-h2 moe-center">Kollektionen</h1>
    <div class="moe-products__grid">
      {%- for collection in collections -%}
        <a class="moe-pcard moe-reveal" href="{{ collection.url }}">
          <div class="moe-pcard__img">
            {%- assign img = collection.featured_image | default: collection.products.first.featured_media -%}
            {%- if img -%}
              {{ img | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 50vw', widths: '400, 800', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'moe-placeholder' }}
            {%- endif -%}
          </div>
          <div class="moe-pcard__body">
            <h2 class="moe-pcard__title">{{ collection.title }}</h2>
            <span class="moe-pcard__desc">{{ collection.products_count }} Produkte</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Kollektionsliste", "settings": [] }
{% endschema %}
