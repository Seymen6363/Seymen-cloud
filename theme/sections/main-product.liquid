{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="moe moe-pdp">
  <div class="moe-wrap moe-pdp__grid">
    <div class="moe-pdp__gallery">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          <div class="moe-pdp__media{% if forloop.first %} moe-pdp__media--main{% endif %}">
            {%- case media.media_type -%}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1200x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
              {%- else -%}
                {%- if forloop.first -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 55vw, 100vw', widths: '600, 900, 1200, 1600', alt: media.alt | default: product.title }}
                {%- else -%}
                  {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 27vw, 50vw', widths: '400, 800, 1200', alt: media.alt | default: product.title }}
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="moe-pdp__media moe-pdp__media--main">{{ 'product-1' | placeholder_svg_tag: 'moe-placeholder' }}</div>
      {%- endif -%}
    </div>

    <div class="moe-pdp__info">
      {%- if product.vendor != blank and section.settings.show_vendor -%}<span class="moe-eyebrow">{{ product.vendor }}</span>{%- endif -%}
      <h1 class="moe-h2">{{ product.title }}</h1>

      <div class="moe-pdp__price" data-moe-price>
        <strong>{{ current_variant.price | money }}</strong>
        {%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
      </div>
      <div class="moe-pdp__tax">
        {%- if cart.taxes_included -%}inkl. MwSt.{%- else -%}zzgl. MwSt.{%- endif -%}
        {%- if shop.shipping_policy.body != blank -%}, zzgl. <a href="{{ shop.shipping_policy.url }}">Versandkosten</a>{%- endif -%}
        {%- if current_variant.unit_price_measurement -%}
          <br><span data-moe-unit>{{ current_variant.unit_price | money }} / {% if current_variant.unit_price_measurement.reference_value != 1 %}{{ current_variant.unit_price_measurement.reference_value }}{% endif %}{{ current_variant.unit_price_measurement.reference_unit }}</span>
        {%- endif -%}
      </div>

      {%- form 'product', product, class: 'moe-pdp__form', data-moe-product-form: '' -%}
        {%- unless product.has_only_default_variant -%}
          <label class="moe-label" for="Variant-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
          <select class="moe-input" id="Variant-{{ section.id }}" name="id" data-moe-variant-select>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"
                {% if variant == current_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                data-price="{{ variant.price | money | escape }}"
                data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                data-available="{{ variant.available }}">
                {{ variant.title }}{% unless variant.available %} – ausverkauft{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endunless -%}

        <div class="moe-pdp__buy">
          <label class="moe-visually-hidden" for="Qty-{{ section.id }}">Menge</label>
          <input class="moe-input moe-qty" id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1">
          <button class="moe-btn moe-btn--block" type="submit" name="add" data-moe-add {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}In den Warenkorb{%- else -%}Ausverkauft{%- endif -%}
          </button>
        </div>
        {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
      {%- endform -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badges' -%}
            <ul class="moe-pdp__badges" {{ block.shopify_attributes }}>
              {%- if block.settings.b1 != blank -%}<li>{{ block.settings.b1 }}</li>{%- endif -%}
              {%- if block.settings.b2 != blank -%}<li>{{ block.settings.b2 }}</li>{%- endif -%}
              {%- if block.settings.b3 != blank -%}<li>{{ block.settings.b3 }}</li>{%- endif -%}
            </ul>
          {%- when 'collapsible' -%}
            <details class="moe-pdp__details" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div>{{ block.settings.content }}{% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}

      <div class="moe-pdp__desc rte">{{ product.description }}</div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | json }},
    {%- if product.featured_media -%}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: product.url | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Produktseite",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Marke anzeigen", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Express-Checkout-Buttons (PayPal, Apple Pay …)", "default": true }
  ],
  "blocks": [
    { "type": "badges", "name": "Vorteile", "limit": 1, "settings": [
      { "type": "text", "id": "b1", "label": "Vorteil 1", "default": "Versand in 1–3 Werktagen" },
      { "type": "text", "id": "b2", "label": "Vorteil 2", "default": "Plastikfreie Verpackung" },
      { "type": "text", "id": "b3", "label": "Vorteil 3", "default": "Handgemacht in kleinen Chargen" }
    ] },
    { "type": "collapsible", "name": "Aufklapp-Text", "settings": [
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Inhaltsstoffe" },
      { "type": "richtext", "id": "content", "label": "Inhalt" },
      { "type": "page", "id": "page", "label": "Oder Inhalt einer Seite" }
    ] }
  ]
}
{% endschema %}
