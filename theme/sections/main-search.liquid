<section class="moe moe-products moe-page-top">
  <div class="moe-wrap">
    <h1 class="moe-h2 moe-center">Suche</h1>
    <form action="{{ routes.search_url }}" method="get" class="moe-search" role="search">
      <label class="moe-visually-hidden" for="Search">Suchbegriff</label>
      <input class="moe-input" id="Search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Wonach suchst du?">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="moe-btn" type="submit">Suchen</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="moe-center">{{ search.results_count }} Ergebnis(se) für „{{ search.terms | escape }}“</p>
        <div class="moe-products__grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, index: forloop.index0 %}
            {%- else -%}
              <a class="moe-pcard" href="{{ item.url }}">
                <div class="moe-pcard__body"><h2 class="moe-pcard__title">{{ item.title }}</h2>
                <span class="moe-pcard__desc">{{ item.content | strip_html | truncatewords: 20 }}</span></div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Suche", "settings": [] }
{% endschema %}
